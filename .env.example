# 折淘客 API 密钥（从折淘客开放平台获取）
# 请勿将 .env 提交到版本库
ZHETAOKE_APPKEY=your_appkey_here

# 搜索时并发 HTTP 数（search_result / api_all / jd_goods_list），默认 6，最大 30；过大可能触发折淘客限流
# SEARCH_FETCH_CONCURRENCY=6

# 用户点「下一页」且当前缓存不够翻页时，自动向联盟拉取的最多波次数（含首次：波次 0…max-1），默认 5，最大 20；小于 2 时按 2 处理（否则无法续拉）
# SEARCH_MAX_WAVES=5

# 淘宝推广位 PID（自动生成推广链接时使用，格式 mm_联盟ID_siteId_adzoneId）
# ZHETAOKE_TAOBAO_PID=mm_xxx_xxx_xxx

# 京东联盟（转链用 unionId/pid/positionId，订单查询用 app_key/secret）
# ZHETAOKE_JD_UNION_ID=导购媒体id
# ZHETAOKE_JD_PID=网站ID_联盟ID_推广位ID（生成推广链接时用）
# ZHETAOKE_JD_APP_KEY=京东开放平台appkey
# ZHETAOKE_JD_APP_SECRET=京东开放平台secret
